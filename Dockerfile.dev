FROM node:24-bookworm-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates ffmpeg gosu \
    && rm -rf /var/lib/apt/lists/*
ENV FFMPEG_PATH=/usr/bin/ffmpeg
COPY package.json yarn.lock ./
COPY scripts/postinstall-prisma.mjs scripts/prepare-husky.mjs scripts/
RUN yarn install --frozen-lockfile
COPY . .
RUN yarn db:generate
COPY --chmod=755 entrypoint.sh /usr/local/bin/fluxer-entrypoint.sh
COPY --chmod=755 entrypoint.dev.sh /usr/local/bin/fluxer-dev-entrypoint.sh
ENTRYPOINT ["/usr/local/bin/fluxer-dev-entrypoint.sh"]
CMD ["yarn", "dev"]
