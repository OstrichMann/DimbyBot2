# Prefer starting from the repository root with .env.fluxer loaded into the process.
# When running the Dashboard independently, supply the SAME Fluxer database and auth secret as the Bot.
DATABASE_URL=postgresql://fluxer:replace-with-fresh-password@127.0.0.1:5434/dimbybot_fluxer
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-new-independent-secret-at-least-32-characters
FLUXER_INSTANCE_ORIGIN=https://fluxer.com
FLUXER_CLIENT_ID=1234567890123456789
FLUXER_CLIENT_SECRET=replace-with-fluxer-oauth-client-secret
API_PROXY_TARGET=http://127.0.0.1:3010
BOT_API_PORT=3010
# WEBSOCKET_CLIENT_URL=wss://your-fluxer-dashboard.example/ws
