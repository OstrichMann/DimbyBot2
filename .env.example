# Copy to .env.fluxer. This independent version does not read Discord's .env.
FLUXER_INSTANCE_ORIGIN=https://fluxer.com
FLUXER_BOT_TOKEN=replace-with-raw-fluxer-bot-token
FLUXER_CLIENT_ID=1234567890123456789
FLUXER_CLIENT_SECRET=replace-with-fluxer-oauth-client-secret
BOT_COMMAND_PREFIX=!

# Register this exact OAuth redirect with the Fluxer application:
# http://localhost:3000/api/auth/oauth2/callback/fluxer
BETTER_AUTH_URL=http://localhost:3000
# Generate a NEW secret, e.g. node -e 'console.log(require("crypto").randomBytes(48).toString("hex"))'
BETTER_AUTH_SECRET=replace-with-a-new-independent-secret-at-least-32-characters

# Fresh Fluxer database only. Do not point at the Discord database.
POSTGRES_USER=fluxer
POSTGRES_DB=dimbybot_fluxer
POSTGRES_PASSWORD=replace-with-a-new-hex-database-password
POSTGRES_HOST_PORT=5434
DATABASE_URL=postgresql://fluxer:replace-with-a-new-hex-database-password@127.0.0.1:5434/dimbybot_fluxer
# Optional explicit DB URL for containers; otherwise entrypoints use the fresh fluxer-db service.
# FLUXER_DOCKER_DATABASE_URL=

# Host execution uses published dependency ports; Compose supplies internal service origins.
LAVALINK_ORIGIN=http://127.0.0.1:2334
LAVALINK_PASSWORD=replace-with-a-new-metadata-password
LAVALINK_HOST_PORT=2334
LAVALINK_YOUTUBE_CIPHER_PASSWORD=replace-with-a-new-cipher-password
LAVALINK_SPOTIFY_ENABLED=true
LAVALINK_SPOTIFY_COUNTRY_CODE=US
# Optional Spotify app credentials; anonymous catalog metadata is attempted by default.
LAVALINK_SPOTIFY_CLIENT_ID=
LAVALINK_SPOTIFY_CLIENT_SECRET=
INVIDIOUS_COMPANION_URL=http://127.0.0.1:8283
# Generate a NEW exactly 16-character alphanumeric key (8 random bytes as hex).
INVIDIOUS_COMPANION_KEY=0123456789abcdef
COMPANION_HOST_PORT=8283

BOT_API_HOST=127.0.0.1
BOT_API_PORT=3010
BOT_API_REQUIRE_PRIVATE_CLIENT_IP=1
API_PROXY_TARGET=http://127.0.0.1:3010
WEB_PORT=3000
# In production, route /ws on the SAME cookie host as the Dashboard over WSS.
# WEBSOCKET_CLIENT_URL=wss://your-fluxer-dashboard.example/ws
# Local development uses ws://localhost:3010/ws automatically.
LOG_LEVEL=info

# Optional local image names; no publication or deployment is configured.
BOT_IMAGE=dimbybot-fluxer-bot:local
WEB_IMAGE=dimbybot-fluxer-dashboard:local
LAVALINK_IMAGE=dimbybot-fluxer-metadata:local
